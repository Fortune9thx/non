# Non — root example environment.
#
# The application's own configuration lives in frontend/.env.example; copy
# that file to frontend/.env to run the app. It is duplicated here so the
# full set of configurable values is visible from the repository root.
#
# VITE_CONTRACT_ADDRESS is deliberately EMPTY. With no address the app
# renders its real empty state and says the protocol is not deployed. Set it
# only after gen_getContractSchema confirms a live deploy.
VITE_CONTRACT_ADDRESS=
VITE_GENLAYER_RPC_URL=https://studio-dev.genlayer.com/api
VITE_GENLAYER_CHAIN_ID=61997
VITE_EXPLORER=https://explorer-studio-dev.genlayer.com
