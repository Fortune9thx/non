# Non frontend configuration.
#
# VITE_CONTRACT_ADDRESS is deliberately EMPTY by default. With no address
# the app renders its real empty state and says the protocol is not
# deployed -- it never invents cases, bonds or verdicts to fill the space.
# Set this only after a deploy has been confirmed live on chain.
VITE_CONTRACT_ADDRESS=
VITE_GENLAYER_RPC_URL=https://studio-dev.genlayer.com/api
VITE_GENLAYER_CHAIN_ID=61997
VITE_EXPLORER=https://explorer-studio-dev.genlayer.com
